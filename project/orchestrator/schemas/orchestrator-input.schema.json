            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            }
          ],
          "title": "Data Confidence"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        },
        "risk_factors": {
          "items": {
            "type": "string"
          },
          "title": "Risk Factors",
          "type": "array"
        },
        "source": {
          "$ref": "#/$defs/AssessmentSource",
          "default": "UNKNOWN"
