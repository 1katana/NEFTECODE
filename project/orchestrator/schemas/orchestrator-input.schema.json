        "model_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Version"
        }
      },
      "required": [
        "reliability_risk",
        "risk_score",
        "data_confidence"
      ],
      "title": "ReliabilityAssessment",
      "type": "object"
    },
    "ReliabilityRisk": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ],
      "title": "ReliabilityRisk",
      "type": "string"
    },
    "SafetyResult": {
      "additionalProperties": false,
      "properties": {
        "constraint_passed": {
          "title": "Constraint Passed",
          "type": "boolean"
        },
        "violations": {
          "items": {
            "type": "string"
          },
          "title": "Violations",
          "type": "array"
        },
        "rejection_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rejection Reason"
        }
      },
      "required": [
        "constraint_passed",
        "violations"
      ],
      "title": "SafetyResult",
      "type": "object"
    },
    "ScenarioEvaluation": {
      "additionalProperties": false,
      "properties": {
        "candidate": {
          "$ref": "#/$defs/CandidateAction"
        },
        "quality_prediction": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Quality Prediction"
        },
        "violation_probability": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Violation Probability"
        },
        "reliability_risk": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReliabilityRisk"
            },
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reliability Risk"
        },
        "constraint_passed": {
          "title": "Constraint Passed",
          "type": "boolean"
        },
        "violations": {
          "items": {
            "type": "string"
          },
          "title": "Violations",
          "type": "array"
        },
        "score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Score"
        },
        "grade": {
          "anyOf": [
            {
              "enum": [
                "SUMMER",
                "WINTER"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Grade"
        },
        "metrics": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProductQualityMetrics"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "candidate_horizon_hours": {
          "anyOf": [
            {
              "maximum": 3.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidate Horizon Hours"
        }
      },
      "required": [
        "candidate",
        "quality_prediction",
        "violation_probability",
        "reliability_risk",
        "constraint_passed",
        "violations",
        "score"
      ],
      "title": "ScenarioEvaluation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "pattern": "^1\\.0\\.0$",
      "title": "Schema Version",
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "process_state": {
      "$ref": "#/$defs/ProcessState"
    },
    "current_quality": {
      "$ref": "#/$defs/ComponentResult_QualityAssessment_"
    },
    "current_reliability": {
      "$ref": "#/$defs/ComponentResult_ReliabilityAssessment_"
    },
    "current_safety": {
      "$ref": "#/$defs/ComponentResult_SafetyResult_"
    },
    "scenarios": {
      "items": {
        "$ref": "#/$defs/ScenarioEvaluation"
      },
      "title": "Scenarios",
      "type": "array"
    },
    "optimization": {
      "$ref": "#/$defs/ComponentResult_OptimizationResult_"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "process_state",
    "current_quality",
    "current_reliability",
    "current_safety",
    "scenarios",
    "optimization"
  ],
  "title": "OrchestratorInput",
  "type": "object"
}
