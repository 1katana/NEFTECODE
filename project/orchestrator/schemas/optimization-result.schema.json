{
  "$defs": {
    "CandidateAction": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "minLength": 1,
          "title": "Candidate Id",
          "type": "string"
        },
        "changes": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Changes",
          "type": "object"
        },
        "delta": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Delta",
          "type": "object"
        },
        "horizon_hours": {
          "default": 1.0,
          "maximum": 3.0,
          "minimum": 0.0,
          "title": "Horizon Hours",
          "type": "number"
        }
      },
      "required": [
        "candidate_id",
        "changes"
      ],
      "title": "CandidateAction",
      "type": "object"
    },
    "InputSource": {
      "enum": [
        "SYNTHETIC",
        "HISTORICAL",
        "LIVE"
      ],
      "title": "InputSource",
      "type": "string"
    },
    "OptimizationStatus": {
      "enum": [
        "SUCCESS",
        "NO_FEASIBLE_SOLUTION"
      ],
      "title": "OptimizationStatus",
      "type": "string"
    },
    "RankedCandidate": {
      "additionalProperties": false,
      "properties": {
        "rank": {
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "score_components": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Score Components",
          "type": "object"
        },
        "candidate": {
          "$ref": "#/$defs/CandidateAction"
        }
      },
      "required": [
        "rank",
        "candidate"
      ],
      "title": "RankedCandidate",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "status": {
      "$ref": "#/$defs/OptimizationStatus"
    },
    "ranked_candidates": {
      "items": {
        "$ref": "#/$defs/RankedCandidate"
      },
      "title": "Ranked Candidates",
      "type": "array"
    },
    "reasons": {
      "items": {
        "type": "string"
      },
      "title": "Reasons",
      "type": "array"
    },
    "input_source": {
      "anyOf": [
        {
          "$ref": "#/$defs/InputSource"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "uses_mock_assessments": {
      "default": false,
      "title": "Uses Mock Assessments",
      "type": "boolean"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    },
    "selection_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Selection Reason"
    },
    "generated_count": {
      "default": 0,
      "minimum": 0,
      "title": "Generated Count",
      "type": "integer"
    },
    "search_truncated": {
      "default": false,
      "title": "Search Truncated",
      "type": "boolean"
    }
  },
  "required": [
    "status",
    "ranked_candidates"
  ],
  "title": "OptimizationResult",
  "type": "object"
}
