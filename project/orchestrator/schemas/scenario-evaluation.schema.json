      "title": "ProductQualityMetrics",
      "type": "object"
    },
    "ReliabilityRisk": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ],
      "title": "ReliabilityRisk",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "candidate": {
      "$ref": "#/$defs/CandidateAction"
    },
    "quality_prediction": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Quality Prediction"
    },
    "violation_probability": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Violation Probability"
    },
    "reliability_risk": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReliabilityRisk"
        },
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Reliability Risk"
    },
    "constraint_passed": {
      "title": "Constraint Passed",
      "type": "boolean"
    },
    "violations": {
      "items": {
        "type": "string"
      },
      "title": "Violations",
      "type": "array"
    },
    "score": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Score"
