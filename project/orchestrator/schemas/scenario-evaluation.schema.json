    "candidate_horizon_hours": {
      "anyOf": [
        {
          "maximum": 3.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Candidate Horizon Hours"
    }
  },
  "required": [
    "candidate",
    "quality_prediction",
    "violation_probability",
    "reliability_risk",
    "constraint_passed",
    "violations",
    "score"
  ],
  "title": "ScenarioEvaluation",
  "type": "object"
}
