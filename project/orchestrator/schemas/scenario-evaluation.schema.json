    "grade": {
      "anyOf": [
        {
          "enum": [
            "SUMMER",
            "WINTER"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Grade"
    },
    "metrics": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProductQualityMetrics"
        },
        {
          "type": "null"
        }
      ],
      "default": null
