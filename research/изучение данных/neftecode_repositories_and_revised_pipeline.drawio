          <mxGeometry x="1080" y="430" width="280" height="140" as="geometry" />
        </mxCell>
        <mxCell id="i7" value="Выбираем лучшую модель для нашего QualityAgent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4DFEC;strokeColor=#8064A2;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="700" y="450" width="300" height="110" as="geometry" />
