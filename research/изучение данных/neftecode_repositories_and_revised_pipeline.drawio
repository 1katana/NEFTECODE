  <diagram id="6858d34ac6a8" name="7. Новый пайплайн разработки">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p_t" value="Как меняется пайплайн разработки до 22 сентября" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1F4E78;fontColor=#FFFFFF;strokeColor=#17365D;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="100" y="40" width="1600" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p1" value="9–10 сен РАЗВЕДКА + КАРКАС  • один общий repo • контракты State/Action/Prediction • один timestamp end-to-end на mock • быстро поднять InduTS-SS отдельно" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEBF7;strokeColor=#4472C4;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="180" width="260" height="260" as="geometry" />
        </mxCell>
        <mxCell id="p2" value="11–12 сен ДАННЫЕ  • синхронизация источников • свежесть ЛИМС/ПАК • временное разделение • processed dataset • подключить датасет к стенду моделей" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEBF7;strokeColor=#4472C4;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="370" y="180" width="260" height="260" as="geometry" />
        </mxCell>
        <mxCell id="p3" value="13–15 сен МОДЕЛЬ КАЧЕСТВА  • naive baseline • CatBoost/LightGBM • 1 LSTM/GRU или Transformer из InduTS • выбрать победителя • зафиксировать predict()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEBF7;strokeColor=#4472C4;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="670" y="180" width="260" height="260" as="geometry" />
        </mxCell>
        <mxCell id="p4" value="16 сен SPIKE: РЕАКЦИЯ ПРОЦЕССА  Проверить, учится ли State(t)+Action → State(t+τ).  Если да — оставляем слой. Если нет — НЕ тратим время и упрощаем." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4D6;strokeColor=#ED7D31;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="970" y="180" width="260" height="260" as="geometry" />
        </mxCell>
        <mxCell id="p5" value="17–18 сен ОПТИМИЗАТОР + SAFETY  • 2–4 управляющих параметра • локальный перебор • hard constraints • запас по ошибке • KEEP / REFUSE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEBF7;strokeColor=#4472C4;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1270" y="180" width="260" height="260" as="geometry" />
        </mxCell>
        <mxCell id="p6" value="19–20 сен АГЕНТЫ + СЦЕНАРИИ  • Quality • Reliability • Optimizer • Orchestrator • normal / high sulfur / bad data / no solution" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEBF7;strokeColor=#4472C4;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1570" y="180" width="190" height="260" as="geometry" />
        </mxCell>
        <mxCell id="pe0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="p1" target="p2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pe1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="p2" target="p3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pe2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="p3" target="p4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pe3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="p4" target="p5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pe4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="p5" target="p6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p7" value="21 сен — FREEZE модель, данные, лаг, ограничения, demo timestamps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4DFEC;strokeColor=#8064A2;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="450" y="580" width="400" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p8" value="22 сен — СДАЧА clean run + Streamlit + метрики + README + демо" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4DFEC;strokeColor=#8064A2;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="950" y="580" width="400" height="110" as="geometry" />
        </mxCell>
        <mxCell id="pe6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="p6" target="p7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pe7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="p7" target="p8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p9" value="Главное изменение: мы больше НЕ тратим дни на написание собственного стенда для LSTM/Transformer. InduTS-SS берёт на себя сравнение глубоких моделей. Освободившееся время уходит на наши уникальные части: данные, безопасность, оптимизацию и интеграцию." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F0D9;strokeColor=#70AD47;fontSize=15;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="250" y="780" width="1300" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p10" value="IDAES и перенос кода LostRunes не входят в critical path. Они не должны блокировать готовую версию." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7E6E6;strokeColor=#7F7F7F;fontSize=15;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="500" y="930" width="800" height="70" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="f5ac0b25620e" name="8. Команда и нагрузка">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="w_t" value="Командная работа при 45–70 ч/нед (≈90–140 часов за две недели)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1F4E78;fontColor=#FFFFFF;strokeColor=#17365D;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="100" y="40" width="1600" height="70" as="geometry" />
        </mxCell>
        <mxCell id="w1" value="Поток A — ДАННЫЕ  20–30 ч за 2 недели  • загрузка и синхронизация • теги/единицы • свежесть ЛИМС/ПАК • лаги • processed dataset" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4CCCC;strokeColor=#C00000;fontSize=15;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="180" width="310" height="260" as="geometry" />
        </mxCell>
        <mxCell id="w2" value="Поток B — КАЧЕСТВО / ML  20–30 ч  • baseline • InduTS-SS • 1–2 сложные модели • метрики • заморозка QualityAgent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F0D9;strokeColor=#70AD47;fontSize=15;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="430" y="180" width="310" height="260" as="geometry" />
        </mxCell>
        <mxCell id="w3" value="Поток C — ОПТИМИЗАЦИЯ / SAFETY  20–30 ч  • управляющие параметры • spike модели реакции • перебор вариантов • ограничения • отказ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#BF9000;fontSize=15;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="780" y="180" width="310" height="260" as="geometry" />
        </mxCell>
        <mxCell id="w4" value="Поток D — ИНТЕГРАЦИЯ / DEMO  20–30 ч  • контракты • orchestrator • тесты • Streamlit • Docker/README" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4CCCC;strokeColor=#C00000;fontSize=15;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1130" y="180" width="310" height="260" as="geometry" />
        </mxCell>
        <mxCell id="w5" value="РЕЗЕРВ / ПОДДЕРЖКА  10–20 ч  • EDA • QA сценариев • документация • помочь текущему bottleneck • опциональные эксперименты" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7E6E6;strokeColor=#7F7F7F;fontSize=15;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1480" y="180" width="250" height="260" as="geometry" />
        </mxCell>
        <mxCell id="w6" value="Как наложить на вашу доступность" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F7F7F;fontSize=15;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="120" y="540" width="430" height="80" as="geometry" />
        </mxCell>
        <mxCell id="w7" value="1 человек · 15–20 ч/нед → держит интеграционный critical path и помогает самому узкому месту" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4DFEC;strokeColor=#8064A2;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="120" y="640" width="430" height="130" as="geometry" />
        </mxCell>
        <mxCell id="w8" value="2 человека · 10–15 ч/нед → основные владельцы Data и ML/Optimization" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEBF7;strokeColor=#4472C4;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="680" y="640" width="430" height="130" as="geometry" />
        </mxCell>
        <mxCell id="w9" value="2 человека · 5–10 ч/нед → ограниченные законченные куски: QA, EDA, configs, UI, один эксперимент; не отдавать им критический одиночный компонент" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4D6;strokeColor=#ED7D31;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1240" y="620" width="430" height="170" as="geometry" />
        </mxCell>
        <mxCell id="w10" value="Правило: задача считается законченной не когда «ноутбук работает у автора», а когда результат в main и проходит единый end-to-end тест." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=14;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="300" y="870" width="1200" height="90" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
