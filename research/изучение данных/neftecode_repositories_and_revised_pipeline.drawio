          <mxGeometry x="120" y="200" width="280" height="120" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="Окна прошлых значений последовательность во времени" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9EAF7;strokeColor=#5B9BD5;fontSize=16;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="480" y="200" width="280" height="120" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="LSTM-модель запоминает изменения во времени" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9EAF7;strokeColor=#5B9BD5;fontSize=16;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="840" y="200" width="280" height="120" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="Прогноз H₂S / SO₂" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9EAF7;strokeColor=#5B9BD5;fontSize=16;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1200" y="200" width="260" height="120" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="Streamlit GUI для H₂S" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9EAF7;strokeColor=#5B9BD5;fontSize=16;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1510" y="200" width="220" height="120" as="geometry" />
        </mxCell>
        <mxCell id="se0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="s1" target="s2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="se1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="s2" target="s3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="se2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="s3" target="s4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="se3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="s4" target="s5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s_take" value="ПОЛЕЗНО КАК УЧЕБНЫЙ ПРИМЕР  • как превращать временную таблицу в последовательности • как LSTM получает несколько прошлых моментов и выдаёт прогноз • отдельные модели для показателей качества • простой Streamlit-прототип" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F0D9;strokeColor=#70AD47;fontSize=15;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="120" y="560" width="460" height="260" as="geometry" />
        </mxCell>
        <mxCell id="s_adapt" value="МОЖНО ПОВТОРИТЬ В ЭКСПЕРИМЕНТЕ  • заменить H₂S/SO₂ на нашу серу • подобрать наше временное окно • сравнить LSTM с CatBoost/другой простой моделью  Но проще запускать LSTM через InduTS-SS, чем тащить этот notebook в production." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#BF9000;fontSize=15;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="670" y="560" width="460" height="260" as="geometry" />
        </mxCell>
        <mxCell id="s_own" value="ЧЕГО ЗДЕСЬ НЕТ ДЛЯ НАШЕГО ТЗ  • безопасного оптимизатора режимов • жёстких ограничений • моделей реакции установки на действия • мультиагентности • ЛИМС/ПАК и свежести данных • проверяемого REFUSE  Это не готовая архитектура нашей системы." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4CCCC;strokeColor=#C00000;fontSize=15;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1220" y="560" width="460" height="260" as="geometry" />
        </mxCell>
        <mxCell id="s_note" value="Несмотря на слово «Optimization» в названии, README описывает прежде всего LSTM-прогноз H₂S/SO₂ и GUI; готового constrained optimizer в структуре репозитория не заявлено. Явная лицензия на странице также не обнаружена — используем как reference, не копируем код." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=14;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="250" y="900" width="1300" height="100" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="f9d03139a3bd" name="5. IDAES — что берём">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="d_t" value="IDAES PSE — инженерный конструктор для физического моделирования и оптимизации" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1F4E78;fontColor=#FFFFFF;strokeColor=#17365D;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="100" y="40" width="1600" height="70" as="geometry" />
        </mxCell>
        <mxCell id="d1" value="Схема процесса Flowsheet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9EAF7;strokeColor=#5B9BD5;fontSize=16;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="90" y="190" width="250" height="120" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="Модели аппаратов колонна, реактор, теплообменник..." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9EAF7;strokeColor=#5B9BD5;fontSize=16;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="410" y="190" width="270" height="120" as="geometry" />
        </mxCell>
        <mxCell id="d3" value="Физические свойства и материально-энергетические связи" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9EAF7;strokeColor=#5B9BD5;fontSize=16;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="750" y="190" width="290" height="120" as="geometry" />
        </mxCell>
        <mxCell id="d4" value="Ограничения T, P, расходы, составы..." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9EAF7;strokeColor=#5B9BD5;fontSize=16;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1110" y="190" width="260" height="120" as="geometry" />
        </mxCell>
        <mxCell id="d5" value="Pyomo / solver ищет оптимальный режим" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9EAF7;strokeColor=#5B9BD5;fontSize=16;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1440" y="190" width="270" height="120" as="geometry" />
        </mxCell>
        <mxCell id="d6" value="Суррогатные модели ALAMO / PySMO / Keras / ONNX через OMLT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9EAF7;strokeColor=#5B9BD5;fontSize=16;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="580" y="440" width="350" height="150" as="geometry" />
        </mxCell>
        <mxCell id="d7" value="Можно встроить ML в математическую модель процесса" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4DFEC;strokeColor=#8064A2;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1020" y="455" width="360" height="120" as="geometry" />
        </mxCell>
        <mxCell id="de0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="d1" target="d2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="de1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="d2" target="d3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="de2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="d3" target="d4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="de3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="d4" target="d5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="de4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="d6" target="d7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="de5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="d7" target="d5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d_take" value="ЧТО МОЖНО ПОЗАИМСТВОВАТЬ  • формальный подход «целевая функция + ограничения» • отделение модели процесса от задачи оптимизации • идею flowsheet для цепочки АВТ → гидроочистка → блендинг • возможность в будущем встроить ML-модель внутрь Pyomo/OMLT  Лицензия разрешает использование/изменение при соблюдении условий уведомления." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F0D9;strokeColor=#70AD47;fontSize=15;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="670" width="490" height="270" as="geometry" />
        </mxCell>
        <mxCell id="d_adapt" value="ЕСЛИ БЫ МЫ ВНЕДРЯЛИ IDAES  Нам пришлось бы самим: • описать конкретные аппараты и связи • выбрать/создать пакеты свойств • задать параметры процесса • подтвердить физические ограничения • настроить solver • состыковать наши ML-модели с flowsheet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#BF9000;fontSize=15;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="650" y="670" width="490" height="270" as="geometry" />
        </mxCell>
        <mxCell id="d_later" value="РЕШЕНИЕ ДЛЯ ХАКАТОНА  Не включать IDAES в обязательный MVP.  Причина: это полноценная инженерная платформа, а не готовая модель нашей установки. Без хорошо заданной физической модели она не «догадается», как работает АВТ или гидроочистка.  Оставить как план B / развитие после хакатона." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7E6E6;strokeColor=#7F7F7F;fontSize=15;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1220" y="670" width="490" height="270" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="593bab188f59" name="6. Наша итоговая архитектура">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="a_t" value="Наша итоговая архитектура после разбора репозиториев" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1F4E78;fontColor=#FFFFFF;strokeColor=#17365D;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="100" y="40" width="1600" height="70" as="geometry" />
        </mxCell>
        <mxCell id="a1" value="СЫРЫЕ ДАННЫЕ телеметрия + ЛИМС + ПАК + справочник тегов" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4CCCC;strokeColor=#C00000;fontSize=15;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="190" width="250" height="150" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="НАША ПОДГОТОВКА ДАННЫХ время, единицы, свежесть, пропуски, лаги, режимы" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4CCCC;strokeColor=#C00000;fontSize=15;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="360" y="180" width="300" height="170" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="ИСПЫТАТЕЛЬНЫЙ СТЕНД InduTS-SS + простой CatBoost baseline сравниваем несколько моделей" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F0D9;strokeColor=#70AD47;fontSize=15;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="720" y="180" width="320" height="170" as="geometry" />
        </mxCell>
        <mxCell id="a4" value="QualityAgent замороженная лучшая модель → прогноз серы + неопределённость" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#BF9000;fontSize=15;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1100" y="180" width="300" height="170" as="geometry" />
        </mxCell>
        <mxCell id="a5" value="Модель реакции процесса? State(t)+Action → State(t+τ) только если данные подтверждают" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#BF9000;fontSize=15;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1460" y="180" width="280" height="170" as="geometry" />
        </mxCell>
        <mxCell id="a6" value="Генератор 10–50 вариантов действий по 2–4 управляемым параметрам" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4CCCC;strokeColor=#C00000;fontSize=15;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1450" y="470" width="290" height="140" as="geometry" />
        </mxCell>
        <mxCell id="a7" value="Safety / Reliability жёсткие ограничения + свежесть + риск режима" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4CCCC;strokeColor=#C00000;fontSize=15;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1080" y="470" width="310" height="140" as="geometry" />
        </mxCell>
        <mxCell id="a8" value="Сначала отфильтровать опасное, затем ранжировать допустимое" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#BF9000;fontSize=15;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="710" y="480" width="310" height="120" as="geometry" />
        </mxCell>
        <mxCell id="a9" value="Orchestrator KEEP / RECOMMEND / REFUSE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4CCCC;strokeColor=#C00000;fontSize=15;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="390" y="480" width="260" height="120" as="geometry" />
        </mxCell>
        <mxCell id="a10" value="Streamlit состояние → проблема → действие → эффект → ограничения" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4CCCC;strokeColor=#C00000;fontSize=15;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="470" width="280" height="150" as="geometry" />
        </mxCell>
        <mxCell id="ae0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="a1" target="a2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ae1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="a2" target="a3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ae2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="a3" target="a4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ae3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="a4" target="a5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ae4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="a5" target="a6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ae5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="a6" target="a7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ae6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="a7" target="a8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ae7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="a8" target="a9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ae8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="a9" target="a10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a11" value="LostRunes даёт ПАТТЕРН этого правого контура: варианты → реакция процесса → safety → качество → spec-first выбор." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=14;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="980" y="690" width="650" height="90" as="geometry" />
        </mxCell>
        <mxCell id="a12" value="InduTS-SS живёт СБОКУ от production: он помогает выбрать модель, но после выбора рабочему приложению нужен только единый predict()." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=14;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="180" y="690" width="650" height="90" as="geometry" />
        </mxCell>
        <mxCell id="a13" value="IDAES не нужен, чтобы эта схема заработала. Позже он может заменить простой перебор/часть модели процесса на формальную инженерную оптимизацию." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7E6E6;strokeColor=#7F7F7F;fontSize=15;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="550" y="830" width="700" height="90" as="geometry" />
        </mxCell>
        <mxCell id="alg0" value="ЛЕГЕНДА" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F7F7F;fontSize=15;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="965" width="150" height="55" as="geometry" />
        </mxCell>
        <mxCell id="alg1" value="Можно взять / подключить" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F0D9;strokeColor=#70AD47;fontSize=15;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="250" y="965" width="270" height="55" as="geometry" />
        </mxCell>
        <mxCell id="alg2" value="Нужно адаптировать" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#BF9000;fontSize=15;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="540" y="965" width="270" height="55" as="geometry" />
        </mxCell>
        <mxCell id="alg3" value="Разрабатываем сами" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4CCCC;strokeColor=#C00000;fontSize=15;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="830" y="965" width="270" height="55" as="geometry" />
        </mxCell>
        <mxCell id="alg4" value="Позже / не в MVP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7E6E6;strokeColor=#7F7F7F;fontSize=15;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1120" y="965" width="270" height="55" as="geometry" />
